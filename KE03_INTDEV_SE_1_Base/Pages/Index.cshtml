@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<link rel='stylesheet' type='text/css' media='screen' href='~/css/index.css'>
<div>
    <h2 class="title">Meest verkochte producten</h2>
    <div class="bestSellingContainer">
        @foreach(var p in Model.BestSellingProducts)
        {
            <div class="productContainer">
                <a asp-page="/Product" asp-route-id="@p.Id" class="productLink"></a>
                <div><img src="@p.ImageUrl" class="productImg"/></div>
                <div class="productAnouncement">
                    <p class="productTitle">@Html.DisplayName(p.Name)</p>
                    <p class="productPrice">€@p.Price.ToString()</p>
                </div>
            </div>
        }
    </div>
</div>

