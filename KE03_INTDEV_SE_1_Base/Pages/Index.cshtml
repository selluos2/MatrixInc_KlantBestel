@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<h2>Meest verkochte producten</h2>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Descriptie</th>
            <th>Prijs</th>
        </tr>
    </thead>
    @foreach (var p in Model.BestSellingProducts)
    {
        <tr>
            <td>@Html.DisplayName("$" + p.Name)</td>
            <td>@Html.DisplayName("$" + p.Description)</td>
            <td>@Html.DisplayName("$" + p.Price.ToString())</td>
        </tr>
    }
</table>